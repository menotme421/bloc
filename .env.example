# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App origin used for OAuth redirects (e.g. https://blocapps.com)
NEXT_PUBLIC_SITE_URL=

# Optional remote code runner (Java-only — JS/TS, Python, C++, PHP and
# HTML/CSS all run locally in the browser; Java has no in-browser JVM).
# Pick a provider with RUN_PROVIDER, then configure it:
#
# A) JDoodle cloud (no hosting needed — recommended).
#    Free account at jdoodle.com -> API dashboard -> subscribe to the free
#    API plan (daily free 20 credits, 1 run = 1 credit) -> copy credentials:
# ENABLE_PISTON_RUNNER=true
# NEXT_PUBLIC_ENABLE_PISTON_RUNNER=true
# RUN_PROVIDER=jdoodle
# JDOODLE_CLIENT_ID=your-client-id
# JDOODLE_CLIENT_SECRET=your-client-secret
# JDOODLE_JAVA_VERSION_INDEX=5
#
# B) Self-hosted Piston (MIT, Docker: ghcr.io/engineer-man/piston).
#    NOTE: the public emkc.org instance is whitelist-only since Feb 2026,
#    so either self-host or attach an issued token:
# ENABLE_PISTON_RUNNER=true
# NEXT_PUBLIC_ENABLE_PISTON_RUNNER=true
# RUN_PROVIDER=piston
# PISTON_API_URL=http://your-host:2000/api/v2/execute
# PISTON_API_KEY=your-token-here