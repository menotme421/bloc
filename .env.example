# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App origin used for OAuth redirects (e.g. https://blocapps.com)
NEXT_PUBLIC_SITE_URL=

# Optional remote code runner (Piston). Keep off unless you need
# non-local execution — JS/Python/C++/HTML/CSS run locally in the browser.
# Java always needs this; other languages use it as a full-fidelity fallback.
#
# NOTE (Feb 2026): the public emkc.org instance is whitelist-only. Either
# self-host Piston (MIT, Docker: ghcr.io/engineer-man/piston) ...
# ENABLE_PISTON_RUNNER=true
# NEXT_PUBLIC_ENABLE_PISTON_RUNNER=true
# PISTON_API_URL=http://your-host:2000/api/v2/execute
# ... or keep the public URL and attach an issued token (sent verbatim as the
# `Authorization` header):
# PISTON_API_URL=https://emkc.org/api/v2/piston/execute
# PISTON_API_KEY=your-token-here